# 微信公众号配置
wechat:
  app_id: "your_app_id"
  app_secret: "your_app_secret"
  token: "your_token"

# 服务器配置
server:
  port: 8080
  mode: "debug" # debug, release

# API 访问控制配置
api:
  # IP 白名单，支持多个 IP（如果启用频率限制，可以只保留 127.0.0.1）
  ip_whitelist:
    - "127.0.0.1"
  # API Key，支持多个 Key（明文存储，服务器端会自动进行哈希验证）
  api_keys:
    - "your_api_key"
  # 频率限制配置
  rate_limit:
    enabled: true              # 是否启用频率限制
    max_draft_per_day: 5       # 每个 API Key 每天最多创建草稿次数

# 日志配置
log:
  # 日志级别：debug, info, warn, error
  level: "info"
  # 日志文件路径
  path: "./logs"
  # 是否在控制台打印日志
  console: true
  # 单个日志文件最大大小（MB）
  max_size: 100
  # 最大备份文件数
  max_backups: 10
  # 日志文件最大保存天数
  max_age: 30
  # 是否压缩日志文件
  compress: false